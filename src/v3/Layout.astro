---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/plus-jakarta-sans';
import './styles.css';
import VersionSwitch from '../components/VersionSwitch.astro';
import { site, assertNoPlaceholders } from '../config/site';

assertNoPlaceholders();

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.seo.description } = Astro.props;
const fullTitle = title ? `${title} — ${site.name.value}` : site.seo.title;
const tel = site.phone.value.replace(/[^\d+]/g, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {site.mode === 'demo' && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0c1626" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <script is:inline>
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (!window.__motion) document.documentElement.classList.remove('js');
      }, 2500);
    </script>
    <style is:global>
      .js [data-split],
      .js [data-pre-hide] {
        visibility: hidden;
      }
    </style>
  </head>
  <body class="bg-porcelain text-ink">
    <!-- Top bar -->
    <header data-topbar class="topbar fixed inset-x-0 top-0 z-50">
      <div class="mx-auto flex h-16 max-w-[1280px] items-center justify-between gap-4 px-4 md:px-6">
        <a href="/v3" class="flex items-center gap-3">
          <span class="grid size-9 place-items-center rounded-full bg-night font-display text-sm text-gold">{site.initials}</span>
          <span class="leading-tight">
            <span class="block text-sm font-bold">{site.name.value}</span>
            <span class="topbar-sub block text-xs text-slate">{site.role}</span>
          </span>
        </a>
        <div class="flex items-center gap-2">
          <button type="button" data-share class="btn btn-ghost hidden px-3.5! py-2.5! sm:inline-flex" aria-label="Share profile">
            <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M10 13V3m0 0L6.5 6.5M10 3l3.5 3.5"></path><path d="M4 10v6h12v-6"></path></svg>
          </button>
          <button type="button" data-vcard class="btn btn-ghost hidden py-2.5! md:inline-flex">Save contact</button>
          <button type="button" data-chat-open class="btn btn-primary py-2.5!">
            <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3.5 15.5 4.6 12A6.5 6.5 0 1 1 8 15.4z"></path></svg>
            Message
          </button>
        </div>
      </div>
    </header>

    <main id="main" class="relative">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-night text-porcelain">
      <div class="mx-auto max-w-[1280px] px-4 pt-20 pb-28 md:px-6 md:pb-16">
        <div class="grid gap-12 md:grid-cols-12 md:items-end">
          <div class="md:col-span-7">
            <p class="label text-gold">Your next move starts with a conversation</p>
            <p class="mt-5 font-display text-title font-light">Let’s talk about <em class="italic">home.</em></p>
          </div>
          <div class="flex flex-wrap gap-3 md:col-span-5 md:justify-end">
            <button type="button" data-chat-open class="btn btn-gold">Message Thang</button>
            <a href={`tel:${tel}`} class="btn border border-porcelain/20 hover:border-porcelain/60">{site.phone.value}</a>
          </div>
        </div>
        <div class="mt-16 grid gap-6 border-t border-porcelain/10 pt-8 text-sm text-slate-light md:grid-cols-4">
          <p class="flex items-center gap-2">
            <svg class="size-4 text-gold" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M10 2 3.5 5v4.5c0 4 2.8 7.2 6.5 8.5 3.7-1.3 6.5-4.5 6.5-8.5V5z"></path><path d="m7 10 2 2 4-4"></path></svg>
            Licensed in California · {site.dre.value}
          </p>
          <p>{site.brokerage.value}</p>
          <p>Equal Housing Opportunity</p>
          <p class="md:text-right">© {new Date().getFullYear()} {site.name.value}</p>
        </div>
        <p class="mt-6 max-w-2xl text-xs text-slate-light/80">
          Your details are only used to reply to you. Sales figures come from MLS records; this demo uses sample data.
        </p>
      </div>
    </footer>

    <!-- Desktop message launcher -->
    <button type="button" data-chat-open class="launcher fixed right-5 bottom-5 z-40 hidden items-center gap-3 rounded-full bg-night py-2 pr-5 pl-2 text-porcelain shadow-lift sm:flex" aria-label="Message Thang">
      <span class="relative grid size-10 place-items-center rounded-full bg-night-3 font-display text-sm text-gold">
        {site.initials}
        <span class="absolute -right-0.5 -bottom-0.5 size-3 rounded-full border-2 border-night bg-success"></span>
      </span>
      <span class="text-left leading-tight">
        <span class="block text-sm font-bold">Message Thang</span>
        <span class="block text-xs text-slate-light">Replies personally</span>
      </span>
    </button>

    <!-- Mobile action dock -->
    <nav class="dock fixed inset-x-3 bottom-3 z-40 grid grid-cols-4 rounded-xl bg-night/90 p-1.5 text-porcelain backdrop-blur-xl sm:hidden" aria-label="Quick contact" style="padding-bottom: max(0.375rem, env(safe-area-inset-bottom))">
      <a href={`tel:${tel}`} class="dock-btn"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 3h3l1.5 4-2 1.2a9 9 0 0 0 5.3 5.3l1.2-2 4 1.5v3a1.5 1.5 0 0 1-1.6 1.5A14 14 0 0 1 2.5 4.6 1.5 1.5 0 0 1 4 3z"></path></svg>Call</a>
      <a href={`sms:${tel}`} class="dock-btn"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 5h14v9H8l-4 3v-3H3z"></path></svg>Text</a>
      <button type="button" data-chat-open class="dock-btn bg-gold/15 text-gold"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3.5 15.5 4.6 12A6.5 6.5 0 1 1 8 15.4z"></path></svg>Message</button>
      <button type="button" data-chat-open data-chat-intent="Book a consultation" class="dock-btn"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4.5" width="14" height="12" rx="2"></rect><path d="M3 8.5h14M7 3v3M13 3v3"></path></svg>Book</button>
    </nav>

    <!-- Chat panel -->
    <section data-chat class="chat fixed z-[60] flex flex-col overflow-hidden bg-card shadow-lift" role="dialog" aria-modal="false" aria-label="Message Thang" hidden>
      <header class="flex items-center gap-3 bg-night px-4 py-3.5 text-porcelain">
        <span class="relative grid size-10 place-items-center rounded-full bg-night-3 font-display text-sm text-gold">
          {site.initials}<span class="absolute -right-0.5 -bottom-0.5 size-3 rounded-full border-2 border-night bg-success"></span>
        </span>
        <div class="min-w-0 flex-1 leading-tight">
          <p class="text-sm font-bold">{site.name.value}</p>
          <p class="text-xs text-slate-light">{site.role} · replies personally</p>
        </div>
        <button type="button" data-chat-close class="grid size-9 place-items-center rounded-full hover:bg-porcelain/10" aria-label="Close chat">
          <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m5 5 10 10M15 5 5 15"></path></svg>
        </button>
      </header>
      <div data-chat-log class="flex-1 space-y-3 overflow-y-auto bg-porcelain px-4 py-5" data-lenis-prevent aria-live="polite"></div>
      <div data-chat-actions class="border-t border-ink/8 bg-card p-3"></div>
    </section>

    <!-- Story viewer -->
    <div data-story class="story fixed inset-0 z-[80] grid place-items-center bg-night/95 backdrop-blur-md" role="dialog" aria-modal="true" aria-label="Highlights" hidden>
      <div class="story-frame relative overflow-hidden rounded-xl bg-night-2 shadow-lift">
        <div data-story-media class="absolute inset-0"></div>
        <div class="absolute inset-x-0 top-0 h-36 bg-gradient-to-b from-night/80 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 h-56 bg-gradient-to-t from-night/90 to-transparent"></div>
        <div data-story-bars class="absolute inset-x-3 top-3 flex gap-1"></div>
        <div class="absolute inset-x-3 top-7 flex items-center gap-2.5 text-porcelain">
          <span class="grid size-8 place-items-center rounded-full bg-night-3 font-display text-xs text-gold">{site.initials}</span>
          <span class="text-sm font-bold">{site.name.value}</span>
          <span data-story-label class="text-sm text-slate-light"></span>
          <span class="label ml-auto rounded-full border border-porcelain/25 px-2 py-0.5 text-porcelain/80">Sample</span>
        </div>
        <div class="absolute inset-x-5 bottom-6 text-porcelain">
          <p data-story-title class="font-display text-3xl leading-tight"></p>
          <p data-story-sub class="mt-1 text-sm text-slate-light"></p>
        </div>
        <button type="button" data-story-prev class="absolute inset-y-0 left-0 w-1/3" aria-label="Previous"></button>
        <button type="button" data-story-next class="absolute inset-y-0 right-0 w-2/3" aria-label="Next"></button>
      </div>
      <button type="button" data-story-close class="absolute top-4 right-4 grid size-11 place-items-center rounded-full bg-porcelain/10 text-porcelain hover:bg-porcelain/20" aria-label="Close">
        <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m5 5 10 10M15 5 5 15"></path></svg>
      </button>
    </div>

    <!-- Side drawer (articles, home details) -->
    <div data-drawer class="drawer fixed inset-0 z-[70]" hidden>
      <div data-drawer-scrim class="absolute inset-0 bg-night/50 backdrop-blur-sm"></div>
      <aside class="drawer-panel absolute top-0 right-0 bottom-0 flex w-full max-w-xl flex-col bg-porcelain shadow-lift" role="dialog" aria-modal="true" aria-label="Details">
        <div class="flex items-center justify-between border-b border-ink/8 px-5 py-3.5">
          <p data-drawer-kicker class="label text-slate"></p>
          <button type="button" data-drawer-close class="grid size-9 place-items-center rounded-full hover:bg-mist" aria-label="Close">
            <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m5 5 10 10M15 5 5 15"></path></svg>
          </button>
        </div>
        <div data-drawer-body class="flex-1 overflow-y-auto" data-lenis-prevent></div>
      </aside>
    </div>

    <!-- QR modal -->
    <dialog data-qr class="m-auto w-[min(92vw,380px)] rounded-xl bg-card p-0 text-ink shadow-lift">
      <div class="p-7 text-center">
        <p class="label text-slate">Scan to open this profile</p>
        <div data-qr-svg class="mx-auto mt-5 aspect-square w-60 rounded-md bg-white p-3"></div>
        <p class="mt-5 font-display text-2xl">{site.name.value}</p>
        <p class="text-sm text-slate">Print it on yard signs, flyers and business cards.</p>
        <div class="mt-6 flex justify-center gap-2">
          <button type="button" data-qr-download class="btn btn-primary">Download PNG</button>
          <button type="button" data-qr-close class="btn btn-ghost">Close</button>
        </div>
      </div>
    </dialog>

    <!-- Toast -->
    <p data-toast class="toast pointer-events-none fixed top-20 left-1/2 z-[90] -translate-x-1/2 rounded-full bg-night px-5 py-3 text-sm font-semibold text-porcelain shadow-lift" role="status"></p>

    <VersionSwitch current="c" side="left" />

    <script>
      import './profile';
    </script>
  </body>
</html>

<style>
  .topbar {
    transition: background 0.4s, box-shadow 0.4s, backdrop-filter 0.4s;
  }
  .topbar:global(.is-scrolled) {
    background: color-mix(in oklab, var(--color-porcelain) 82%, transparent);
    backdrop-filter: blur(18px) saturate(1.3);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    box-shadow: 0 1px 0 color-mix(in oklab, var(--color-ink) 8%, transparent);
  }
  .launcher {
    transition: transform 0.5s var(--ease-out-back);
  }
  .launcher:hover {
    transform: translateY(-3px);
  }
  :global(.chat-open) .launcher {
    transform: translateY(140%);
  }
  .dock-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    border-radius: 12px;
    padding: 0.5rem 0;
    font-size: 11px;
    font-weight: 700;
  }
  .dock-btn svg {
    width: 20px;
    height: 20px;
  }
  .chat {
    right: 20px;
    bottom: 20px;
    width: min(400px, calc(100vw - 40px));
    height: min(620px, calc(100svh - 120px));
    border-radius: 22px;
    transform-origin: bottom right;
    animation: chat-in 0.55s var(--ease-out-expo);
  }
  @media (max-width: 639px) {
    .chat {
      inset: 0;
      width: auto;
      height: auto;
      border-radius: 0;
    }
  }
  @keyframes chat-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.96);
    }
  }
  .story-frame {
    width: min(92vw, calc(88svh * 9 / 16));
    aspect-ratio: 9 / 16;
  }
  .story:not([hidden]) {
    animation: fade-in 0.4s var(--ease-out-expo);
  }
  .drawer:not([hidden]) .drawer-panel {
    animation: drawer-in 0.6s var(--ease-out-expo);
  }
  .drawer:not([hidden]) [data-drawer-scrim] {
    animation: fade-in 0.4s;
  }
  @keyframes drawer-in {
    from {
      transform: translateX(100%);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  .toast {
    opacity: 0;
    transform: translate(-50%, -10px);
    transition: opacity 0.35s, transform 0.5s var(--ease-out-expo);
  }
  .toast:global(.is-on) {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>
