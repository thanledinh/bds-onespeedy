---
interface Props {
  href: string;
  variant?: 'solid' | 'light' | 'line' | 'line-light';
  external?: boolean;
  class?: string;
}
const { href, variant = 'solid', external = false, class: cls = '' } = Astro.props;
const look = {
  solid: 'bg-forest text-cream',
  light: 'bg-cream text-ink',
  line: 'border border-ink/25 text-ink',
  'line-light': 'border border-cream/30 text-cream',
}[variant];
const fill = {
  solid: 'bg-ink',
  light: 'bg-sage',
  line: 'bg-forest',
  'line-light': 'bg-cream',
}[variant];
const fillText = variant === 'line' ? 'group-hover:text-cream' : variant === 'line-light' ? 'group-hover:text-ink' : '';
---

<a
  href={href}
  data-magnetic
  class:list={[
    'group relative inline-flex items-center gap-3 overflow-hidden rounded-full px-7 py-4 text-[0.8125rem] font-semibold tracking-wide transition-colors duration-500',
    look,
    fillText,
    cls,
  ]}
  {...external ? { target: '_blank', rel: 'noopener' } : {}}
>
  <span
    class:list={[
      'absolute inset-0 translate-y-full rounded-full transition-transform duration-700 ease-out-expo group-hover:translate-y-0',
      fill,
    ]}
    aria-hidden="true"
  ></span>
  <span class="relative" data-magnetic-inner><slot /></span>
  <svg class="relative size-3 transition-transform duration-500 ease-out-expo group-hover:translate-x-1" viewBox="0 0 12 12" fill="none" aria-hidden="true">
    <path d="M1 6h9M6.5 2.5 10 6l-3.5 3.5" stroke="currentColor" stroke-width="1.3"></path>
  </svg>
</a>
