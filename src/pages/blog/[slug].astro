---
import Base from '../../layouts/Base.astro';
import SampleTag from '../../components/SampleTag.astro';
import Placeholder from '../../components/Placeholder.astro';
import { site } from '../../config/site';
import { posts, type Post } from '../../data/content';
import { unsplash, srcset, longDate } from '../../lib/img';

export function getStaticPaths() {
  return posts.map((post, i) => ({ params: { slug: post.slug }, props: { post, next: posts[(i + 1) % posts.length] } }));
}

interface Props {
  post: Post;
  next: Post;
}
const { post, next } = Astro.props;
---

<Base title={post.title} description={post.excerpt}>
  <article>
    <header class="mx-auto max-w-[1600px] px-6 pt-36 md:px-12 md:pt-48">
      <a href="/blog" class="text-sm text-muted transition-colors hover:text-ink">← Journal</a>
      <p class="mt-10 flex flex-wrap items-center gap-3 text-micro font-medium uppercase text-muted">
        <span class="text-accent">{post.tag}</span>
        <span>{longDate(post.date)}</span>
        <span>{post.minutes} min read</span>
        {post.sample && <SampleTag />}
      </p>
      <h1 data-split class="mt-6 max-w-5xl font-serif text-mega">{post.title}</h1>
      <p data-reveal class="mt-8 max-w-2xl text-xl leading-relaxed text-muted">{post.excerpt}</p>
    </header>

    <div class="mx-auto mt-16 max-w-[1600px] px-6 md:mt-20 md:px-12">
      <div class="aspect-[4/3] overflow-hidden rounded-lg md:aspect-[21/9]">
        <img
          data-parallax="6"
          src={unsplash(post.cover, 2000, 0.5)}
          srcset={srcset(post.cover, 0.5)}
          sizes="100vw"
          alt=""
          class="size-full scale-[1.14] object-cover"
        />
      </div>
    </div>

    <div class="mx-auto grid max-w-[1600px] gap-12 px-6 py-20 md:px-12 md:py-28 lg:grid-cols-12">
      <aside class="order-2 lg:order-1 lg:col-span-3">
        <div class="flex items-center gap-4 lg:sticky lg:top-28 lg:flex-col lg:items-start">
          <Placeholder label="Portrait" icon="portrait" class="size-16 shrink-0 rounded-full [&_span]:hidden lg:size-20" />
          <div>
            <p class="font-medium">{site.name.value}</p>
            <p class="text-sm text-muted">{site.role}</p>
            <a href="/contact" class="mt-3 inline-block text-sm underline decoration-ink/30 underline-offset-4 hover:decoration-ink">Ask a question</a>
          </div>
        </div>
      </aside>

      <div class="prose-article order-1 max-w-2xl lg:order-2 lg:col-span-7">
        {
          post.body.map((block) =>
            'p' in block ? (
              <p>{block.p}</p>
            ) : 'h2' in block ? (
              <h2>{block.h2}</h2>
            ) : 'quote' in block ? (
              <blockquote>{block.quote}</blockquote>
            ) : (
              <ul>
                {block.list.map((li) => (
                  <li>{li}</li>
                ))}
              </ul>
            ),
          )
        }
      </div>
    </div>
  </article>

  <section class="border-t border-ink/10">
    <a href={`/blog/${next.slug}`} class="group mx-auto grid max-w-[1600px] gap-6 px-6 py-20 md:grid-cols-12 md:items-center md:px-12 md:py-28">
      <p class="text-micro font-medium uppercase text-muted md:col-span-3">Next article</p>
      <p class="font-serif text-title decoration-1 underline-offset-[6px] group-hover:underline md:col-span-7">{next.title}</p>
      <div class="md:col-span-2 md:text-right">
        <span class="inline-grid size-14 place-items-center rounded-full bg-ink text-paper transition-transform duration-500 ease-out-expo group-hover:translate-x-2">→</span>
      </div>
    </a>
  </section>
</Base>
