---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { photos } from '../data/media';
import { unsplash } from '../lib/img';
const tel = site.phone.value.replace(/[^\d+]/g, '');
const intents = ['Buy a home', 'Sell a home', 'Buy & sell', 'Just exploring'];
---

<Base title="Contact" description="Contact Thang Truong about buying or selling a home in San Jose and the Bay Area.">
  <section class="mx-auto max-w-[1600px] px-6 pt-36 pb-32 md:px-12 md:pt-48 md:pb-44">
    <div class="grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="text-micro font-medium uppercase text-accent">Contact</p>
        <h1 data-split class="mt-6 font-serif text-mega italic">Let’s talk.</h1>
        <p data-reveal class="mt-8 max-w-md text-lg leading-relaxed text-muted">
          Tell Thang a little about your plans and Thang will get back to you personally.
        </p>

        <dl data-reveal class="mt-12 space-y-6 border-t border-ink/10 pt-8">
          <div>
            <dt class="text-micro font-medium uppercase text-muted">Phone</dt>
            <dd class="mt-2 font-serif text-3xl"><a href={`tel:${tel}`} class="hover:text-accent">{site.phone.value}</a></dd>
          </div>
          <div>
            <dt class="text-micro font-medium uppercase text-muted">Email</dt>
            <dd class="mt-2 font-serif text-3xl break-all"><a href={`mailto:${site.email.value}`} class="hover:text-accent">{site.email.value}</a></dd>
          </div>
          <div>
            <dt class="text-micro font-medium uppercase text-muted">Area</dt>
            <dd class="mt-2 text-lg">{site.area}</dd>
          </div>
        </dl>

        <div data-reveal class="mt-12 hidden aspect-[16/10] overflow-hidden rounded-lg lg:block">
          <img src={unsplash(photos.duskPath, 1100, 0.625)} alt="" loading="lazy" class="size-full object-cover" />
        </div>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <form data-contact data-reveal class="rounded-lg bg-paper-2 p-6 md:p-10" novalidate>
          <fieldset>
            <legend class="text-micro font-medium uppercase text-muted">I’m looking to</legend>
            <div class="mt-4 flex flex-wrap gap-2">
              {
                intents.map((label, i) => (
                  <label class="intent">
                    <input type="radio" name="intent" value={label} class="sr-only" checked={i === 0} />
                    <span>{label}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="mt-10 grid gap-8 md:grid-cols-2">
            <label class="field">
              <span>Full name</span>
              <input name="name" autocomplete="name" required />
            </label>
            <label class="field">
              <span>Phone</span>
              <input name="phone" type="tel" autocomplete="tel" />
            </label>
            <label class="field md:col-span-2">
              <span>Email</span>
              <input name="email" type="email" autocomplete="email" required />
            </label>
            <label class="field md:col-span-2">
              <span>Message</span>
              <textarea name="message" rows="4" placeholder="Neighborhood, timeline, budget, anything that helps."></textarea>
            </label>
          </div>

          <button
            type="submit"
            class="group mt-10 inline-flex w-full items-center justify-between gap-4 rounded-full bg-ink py-1.5 pr-1.5 pl-7 text-sm font-medium text-paper transition-colors hover:bg-ink-2"
          >
            Send message
            <span class="grid size-11 place-items-center rounded-full bg-paper text-ink transition-transform duration-500 ease-out-expo group-hover:translate-x-1">→</span>
          </button>
          <p data-contact-status class="mt-5 hidden rounded-md bg-paper p-4 text-sm" role="status"></p>
          <p class="mt-5 text-xs text-muted">Your details go only to Thang and are never shared.</p>
        </form>
      </div>
    </div>
  </section>
</Base>

<style>
  .intent span {
    display: inline-block;
    border-radius: 9999px;
    border: 1px solid color-mix(in oklab, var(--color-ink) 18%, transparent);
    padding: 0.6rem 1.1rem;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background 0.3s, color 0.3s, border-color 0.3s;
  }
  .intent input:checked + span {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }
  .intent input:focus-visible + span {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .field {
    display: block;
  }
  .field > span {
    display: block;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-muted);
  }
  .field input,
  .field textarea {
    margin-top: 0.5rem;
    width: 100%;
    border: 0;
    border-bottom: 1px solid color-mix(in oklab, var(--color-ink) 22%, transparent);
    background: transparent;
    padding: 0.5rem 0;
    font-size: 1.125rem;
    outline: none;
    transition: border-color 0.3s;
    resize: vertical;
  }
  .field input:focus,
  .field textarea:focus {
    border-color: var(--color-ink);
  }
  .field textarea::placeholder {
    color: color-mix(in oklab, var(--color-muted) 70%, transparent);
  }
  .field input:user-invalid {
    border-color: var(--color-accent);
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]')!;
  const status = form.querySelector<HTMLElement>('[data-contact-status]')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    status.classList.remove('hidden');
    if (!form.checkValidity()) {
      status.textContent = 'Please add your name and a valid email.';
      return;
    }
    status.textContent = 'Demo only: in the live site this message goes straight to Thang’s inbox.';
    form.reset();
  });
</script>
