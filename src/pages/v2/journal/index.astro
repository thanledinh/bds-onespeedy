---
import Layout from '../../../v2/Layout.astro';
import Sample from '../../../v2/Sample.astro';
import { posts } from '../../../data/content';
import { unsplash, srcset, longDate } from '../../../lib/img';
const [lead, ...rest] = posts;
---

<Layout title="Journal" page="journal" description="Notes from Thang Truong on buying, selling and the Bay Area housing market.">
  <section class="mx-auto max-w-[1680px] px-5 pt-36 pb-16 md:px-10 md:pt-48">
    <p class="label flex items-center gap-3 text-stone">Journal <Sample /></p>
    <h1 data-split class="mt-6 font-serif text-hero font-light">Notes from <em class="italic">the market.</em></h1>
    <p data-reveal class="mt-12 max-w-xl border-t border-ink/15 pt-8 leading-relaxed text-stone">
      Practical articles on buying, selling and the local market. Thang writes and publishes them from a simple editor.
    </p>
  </section>

  <section class="mx-auto max-w-[1680px] px-5 pb-16 md:px-10" aria-label="Featured article">
    <a href={`/v2/journal/${lead.slug}`} data-cursor-text="Read" class="group grid gap-8 lg:grid-cols-12 lg:items-end">
      <div data-img-reveal class="aspect-[16/10] overflow-hidden rounded-sm lg:col-span-8">
        <img src={unsplash(lead.cover, 1600, 0.625)} srcset={srcset(lead.cover, 0.625)} sizes="(min-width: 1024px) 64vw, 92vw" alt="" class="size-full object-cover transition-transform duration-1000 ease-out-expo group-hover:scale-[1.03]" />
      </div>
      <div class="lg:col-span-4">
        <p class="label text-stone">{lead.tag} · {longDate(lead.date)} · {lead.minutes} min</p>
        <h2 class="mt-4 font-serif text-5xl leading-[1.02] font-light md:text-6xl">{lead.title}</h2>
        <p class="mt-5 leading-relaxed text-stone">{lead.excerpt}</p>
      </div>
    </a>
  </section>

  <section class="mx-auto max-w-[1680px] px-5 pt-12 pb-32 md:px-10 md:pb-44" aria-label="All articles">
    <div data-index>
      {
        rest.map((p, i) => (
          <a href={`/v2/journal/${p.slug}`} data-index-row data-img={unsplash(p.cover, 700, 1.25)} data-cursor-text="Read" class="group grid grid-cols-12 items-baseline gap-4 border-b border-ink/15 py-8 first:border-t">
            <span class="label col-span-2 text-stone md:col-span-1">{String(i + 2).padStart(2, '0')}</span>
            <span class="col-span-10 font-serif text-3xl leading-tight font-light transition-all duration-500 ease-out-expo group-hover:pl-4 group-hover:italic md:col-span-7 md:text-5xl">{p.title}</span>
            <span class="label col-span-10 col-start-3 text-stone md:col-span-2 md:col-start-auto">{p.tag}</span>
            <span class="col-span-10 col-start-3 text-sm text-stone md:col-span-2 md:col-start-auto md:text-right">{longDate(p.date)}</span>
          </a>
        ))
      }
    </div>
    <div data-index-preview class="pointer-events-none invisible fixed opacity-0 top-0 left-0 z-30 -mt-[170px] -ml-[135px] aspect-[4/5] w-[270px] overflow-hidden rounded-sm shadow-2xl shadow-ink/25" aria-hidden="true">
      <img alt="" class="size-full object-cover" />
    </div>
  </section>
</Layout>
