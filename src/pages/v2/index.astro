---
import Layout from '../../v2/Layout.astro';
import Button from '../../v2/Button.astro';
import Sample from '../../v2/Sample.astro';
import IndexRow from '../../v2/IndexRow.astro';
import { site } from '../../config/site';
import { photos, homePhotos, videos } from '../../data/media';
import { soldHomes, soldStats } from '../../data/sold';
import { posts, videoList, awards } from '../../data/content';
import { unsplash, srcset, money, compactMoney, monthYear, longDate } from '../../lib/img';

const recent = soldHomes.slice(0, 7);
const neighborhoods = [...new Set(soldHomes.map((h) => h.neighborhood))];
const stats = [
  { value: String(soldStats.count), label: 'Homes sold' },
  { value: compactMoney(soldStats.volume), label: 'Sales volume' },
  { value: `+${soldStats.avgOverList}%`, label: 'Average over list' },
  { value: String(soldStats.cities), label: 'Bay Area cities' },
];
const mapHomes = soldHomes.map((h) => ({
  id: h.id,
  lat: h.lat,
  lng: h.lng,
  city: h.city,
  price: money(h.soldPrice),
  place: `${h.neighborhood}, ${h.city}`,
  meta: `${h.beds} bd · ${h.baths} ba · ${h.sqft.toLocaleString('en-US')} sqft · ${monthYear(h.closeDate)}`,
}));
const cityCounts = Object.entries(
  soldHomes.reduce<Record<string, number>>((acc, h) => ((acc[h.city] = (acc[h.city] ?? 0) + 1), acc), {}),
).sort((a, b) => b[1] - a[1]);

const steps = {
  sell: [
    { t: 'Pricing strategy', d: 'Recent sales on your street, read closely, to set a price that draws the right buyers from day one.', img: photos.livingBright },
    { t: 'Preparation', d: 'Repairs, light staging and professional photography, planned week by week so launch day is calm.', img: photos.kitchen },
    { t: 'Launch & marketing', d: 'MLS, open houses, video and social. Your home presented the way buyers remember it.', img: homePhotos[5] },
    { t: 'Negotiation & closing', d: 'Offers compared side by side, terms negotiated, and every deadline tracked to the keys.', img: photos.duskModern },
  ],
  buy: [
    { t: 'Plan', d: 'Budget, pre-approval and the short list of things you will not compromise on.', img: photos.street },
    { t: 'Search', d: 'Tours, neighborhoods and comparable sales, so you know a fair price when you see it.', img: photos.openPlan },
    { t: 'Offer', d: 'An offer priced with care and terms that make it stand out without overreaching.', img: homePhotos[2] },
    { t: 'Close', d: 'Inspections, appraisal and escrow, handled step by step until the door is yours.', img: photos.duskPath },
  ],
};
const tel = site.phone.value.replace(/[^\d+]/g, '');
---

<Layout page="home">
  <!-- ============================================================ HERO -->
  <section data-hero data-dark class="relative h-svh min-h-[640px] overflow-hidden bg-forest text-cream" aria-label="Introduction">
    <img
      data-hero-img
      src={unsplash(photos.duskPath, 2400)}
      srcset={srcset(photos.duskPath, undefined, [768, 1200, 1800, 2400, 3000])}
      sizes="100vw"
      alt="Modern home with a lit garden path at dusk"
      fetchpriority="high"
      class="absolute inset-0 size-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-forest/90 via-forest/25 to-forest/45"></div>

    <div class="absolute inset-x-0 top-24 flex justify-between px-5 md:top-28 md:px-10">
      <p data-hero-fade class="label text-cream/75">{site.role} — San Jose, California</p>
      <p data-hero-fade class="label hidden text-cream/75 sm:block">37.34° N · 121.89° W</p>
    </div>

    <div data-hero-copy class="relative mx-auto flex h-full max-w-[1680px] flex-col justify-end px-5 pb-28 md:px-10 md:pb-36">
      <h1 data-pre-hide class="font-serif text-hero font-light">
        <span class="line"><span data-hero-line>Homes,</span></span>
        <span class="line"><span data-hero-line class="pl-[0.55em] italic">thoughtfully</span></span>
        <span class="line"><span data-hero-line>sold.</span></span>
      </h1>
      <div class="mt-10 grid items-end gap-8 md:grid-cols-12">
        <p data-hero-fade class="max-w-md leading-relaxed text-cream/80 md:col-span-5">
          {site.name.value} helps families buy and sell homes across San Jose and the Bay Area, with clear advice, careful pricing and steady negotiation.
        </p>
        <div data-hero-fade class="flex flex-wrap gap-3 md:col-span-7 md:justify-self-end">
          <Button href="/v2/sold" variant="light">View sold homes</Button>
          <Button href="/v2/contact" variant="line-light">Book a consultation</Button>
        </div>
      </div>
    </div>

    <div data-hero-fade class="absolute inset-x-0 bottom-0 overflow-hidden border-t border-cream/15 py-4" aria-hidden="true">
      <div class="label flex w-max animate-marquee gap-10 text-cream/65 motion-reduce:animate-none">
        {[...neighborhoods, ...neighborhoods].map((n) => <span class="flex items-center gap-10">{n}<span class="text-sage">✦</span></span>)}
      </div>
    </div>
  </section>

  <!-- ============================================================ INTRODUCTION -->
  <section class="mx-auto max-w-[1680px] px-5 py-28 md:px-10 md:py-44">
    <div class="grid gap-10 md:grid-cols-12">
      <p class="label text-stone md:col-span-3 md:pt-3">( 01 ) An introduction</p>
      <div class="md:col-span-9">
        <p data-split class="font-serif text-lead font-light">
          Buying or selling a home is personal. It deserves an advisor who listens first, knows every street, and treats your <em class="italic">biggest decision</em> like the only one on the table.
        </p>
        <div data-reveal class="mt-14 grid max-w-3xl gap-8 text-stone sm:grid-cols-2">
          <p class="leading-relaxed">A short, warm introduction to Thang goes here: background, the neighborhoods Thang knows best, and the languages spoken with clients.</p>
          <p class="leading-relaxed">A second paragraph on how Thang works: availability, communication, and what happens after you make the first call.</p>
        </div>
        <div data-reveal class="mt-12">
          <Button href="/v2/about">Meet Thang</Button>
        </div>
      </div>
    </div>

    <div class="mt-24 grid grid-cols-12 gap-4 md:mt-32 md:gap-6">
      <div data-img-reveal class="col-span-7 aspect-[4/5] overflow-hidden rounded-sm md:col-span-5 md:col-start-2">
        <img src={unsplash(photos.livingWarm, 1200, 1.25)} srcset={srcset(photos.livingWarm, 1.25, [600, 900, 1200, 1600])} sizes="(min-width: 768px) 40vw, 58vw" alt="Sunlit living room" loading="lazy" class="size-full object-cover" />
      </div>
      <div class="col-span-5 self-end md:col-span-4 md:col-start-8">
        <div data-img-reveal class="aspect-[3/4] overflow-hidden rounded-sm">
          <img src={unsplash(photos.kitchen, 900, 1.333)} srcset={srcset(photos.kitchen, 1.333, [480, 768, 1100])} sizes="(min-width: 768px) 32vw, 40vw" alt="Bright kitchen with marble island" loading="lazy" class="size-full object-cover" />
        </div>
        <p class="label mt-4 text-stone">Interiors · sample photography</p>
      </div>
    </div>
  </section>

  <!-- ============================================================ KNOCKOUT: film inside the word -->
  <section data-knockout class="relative h-[320vh] bg-forest text-cream" aria-labelledby="record-title">
    <div class="sticky top-0 h-svh overflow-hidden">
      <video class="absolute inset-0 size-full object-cover" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
        <source media="(min-width: 900px)" src={videos.aerial.hd} type="video/mp4" />
        <source src={videos.aerial.sd} type="video/mp4" />
      </video>
      <!-- White + "screen" keeps the film only inside the black letters; the bone
           "multiply" tint on top turns the white back into the page colour. -->
      <div data-knockout-layer class="absolute inset-0 grid place-items-center bg-white mix-blend-screen" aria-hidden="true">
        <p class="font-sans leading-[0.8] font-extrabold tracking-[-0.045em] text-black" style="font-size: min(28vw, 50vh)">
          <span data-knockout-origin>H</span>OME
        </p>
      </div>
      <div data-knockout-tint class="pointer-events-none absolute inset-0 bg-bone mix-blend-multiply" aria-hidden="true"></div>
      <p data-knockout-hint class="label absolute inset-x-0 bottom-10 text-center text-stone">Keep scrolling</p>

      <div data-knockout-after class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-forest via-forest/50 to-forest/10">
        <div class="mx-auto w-full max-w-[1680px] px-5 pb-16 md:px-10 md:pb-24">
          <p class="label flex items-center gap-3 text-sage">( 02 ) The record <Sample /></p>
          <h2 id="record-title" class="mt-5 max-w-4xl font-serif text-title font-light">Every home, <em class="italic">accounted for.</em></h2>
          <dl class="mt-14 grid grid-cols-2 gap-x-6 gap-y-10 border-t border-cream/15 pt-8 lg:grid-cols-4">
            {
              stats.map((s) => (
                <div>
                  <dd class="font-serif text-stat font-light whitespace-nowrap" data-count-up={s.value}>{s.value}</dd>
                  <dt class="label mt-3 text-stone-light">{s.label}</dt>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ SELECTED SALES (index) -->
  <section class="mx-auto max-w-[1680px] px-5 py-28 md:px-10 md:py-40" aria-labelledby="sales-title">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="label flex items-center gap-3 text-stone">( 03 ) Selected sales <Sample /></p>
        <h2 id="sales-title" data-split class="mt-5 font-serif text-title font-light">Recently <em class="italic">closed.</em></h2>
      </div>
      <Button href="/v2/sold" variant="line">All {soldStats.count} homes</Button>
    </div>

    <div data-index class="mt-14">
      <div class="label hidden grid-cols-12 gap-4 border-b border-ink/15 pb-4 text-stone lg:grid">
        <span class="col-span-1">No.</span><span class="col-span-3">Neighborhood</span><span class="col-span-2">City</span><span class="col-span-2">Home</span><span class="col-span-2">Sold</span><span class="col-span-1">vs. list</span><span class="col-span-1 text-right">Closed</span>
      </div>
      {recent.map((h, i) => <IndexRow home={h} n={i + 1} />)}
    </div>
    <div data-index-preview class="pointer-events-none invisible fixed opacity-0 top-0 left-0 z-30 -mt-[170px] -ml-[135px] aspect-[4/5] w-[270px] overflow-hidden rounded-sm shadow-2xl shadow-ink/25" aria-hidden="true">
      <img alt="" class="size-full object-cover" />
    </div>
  </section>

  <!-- ============================================================ MAP -->
  <section class="bg-bone-2" aria-labelledby="map-title">
    <div class="mx-auto max-w-[1680px] px-5 py-28 md:px-10 md:py-40">
      <div class="grid gap-8 md:grid-cols-12 md:items-end">
        <div class="md:col-span-8">
          <p class="label flex items-center gap-3 text-stone">( 04 ) Where <Sample /></p>
          <h2 id="map-title" data-split class="mt-5 font-serif text-title font-light">{soldStats.count} homes, <em class="italic">one map.</em></h2>
        </div>
        <p data-reveal class="leading-relaxed text-stone md:col-span-4">Every closing pinned where it happened. Tap a city to fly there, or hover a dot for the details.</p>
      </div>

      <div class="mt-14 grid gap-6 lg:grid-cols-12">
        <div data-reveal class="relative aspect-[4/5] overflow-hidden rounded-sm bg-bone sm:aspect-[16/10] lg:col-span-9">
          <p class="label absolute inset-0 grid place-items-center text-stone">Loading map…</p>
          <div data-map class="size-full"></div>
        </div>
        <div data-reveal class="lg:col-span-3">
          <p class="label text-stone">Filter by city</p>
          <ul class="mt-4 grid grid-cols-2 gap-x-4 sm:grid-cols-3 lg:grid-cols-1">
            <li>
              <button type="button" data-map-city="*" aria-pressed="true" class="city-btn">
                All cities <span>{soldStats.count}</span>
              </button>
            </li>
            {
              cityCounts.map(([city, n]) => (
                <li>
                  <button type="button" data-map-city={city} aria-pressed="false" class="city-btn">
                    {city} <span>{n}</span>
                  </button>
                </li>
              ))
            }
          </ul>
          <p class="mt-6 text-xs text-stone">Demo pins are placed at sample locations. The live site uses each closing’s real address.</p>
        </div>
      </div>
    </div>
    <script type="application/json" id="homes-data" set:html={JSON.stringify(mapHomes)} />
  </section>

  <!-- ============================================================ PROCESS -->
  <section data-process class="mx-auto max-w-[1680px] px-5 py-28 md:px-10 md:py-40" aria-labelledby="process-title">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="label text-stone">( 05 ) How it works</p>
        <h2 id="process-title" data-split class="mt-5 font-serif text-title font-light">A clear path, <em class="italic">start to keys.</em></h2>
      </div>
      <div role="tablist" aria-label="Process" class="flex gap-1 rounded-full border border-ink/15 p-1">
        <button type="button" role="tab" aria-selected="true" data-process-tab="sell" class="tab">Selling</button>
        <button type="button" role="tab" aria-selected="false" data-process-tab="buy" class="tab">Buying</button>
      </div>
    </div>

    <div class="mt-16 grid gap-10 lg:grid-cols-12">
      <div class="hidden lg:col-span-6 lg:block">
        <div class="sticky top-28 aspect-[4/5] overflow-hidden rounded-sm bg-bone-2">
          {
            (['sell', 'buy'] as const).flatMap((k) =>
              steps[k].map((s, i) => (
                <img
                  data-process-img={`${k}-${i + 1}`}
                  src={unsplash(s.img, 1100, 1.25)}
                  alt=""
                  loading="lazy"
                  class:list={['process-img absolute inset-0 size-full object-cover', k === 'sell' && i === 0 && 'is-on']}
                />
              )),
            )
          }
        </div>
      </div>
      <div class="lg:col-span-5 lg:col-start-8">
        {
          (['sell', 'buy'] as const).map((k) => (
            <ol data-process-list={k} hidden={k === 'buy'}>
              {steps[k].map((s, i) => (
                <li data-process-step={`${k}-${i + 1}`} class="step border-t border-ink/15 py-10 lg:flex lg:min-h-[62vh] lg:flex-col lg:justify-center lg:py-0">
                  <p class="label text-brass">Step {String(i + 1).padStart(2, '0')}</p>
                  <h3 class="mt-4 font-serif text-5xl font-light">{s.t}</h3>
                  <p class="mt-4 max-w-md leading-relaxed text-stone">{s.d}</p>
                  <img src={unsplash(s.img, 900, 0.75)} alt="" loading="lazy" class="mt-8 aspect-[4/3] w-full rounded-sm object-cover lg:hidden" />
                </li>
              ))}
            </ol>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================ MORTGAGE CALCULATOR -->
  <section data-dark class="bg-forest text-cream" aria-labelledby="calc-title">
    <div class="mx-auto grid max-w-[1680px] gap-14 px-5 py-28 md:px-10 md:py-40 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="label text-sage">( 06 ) Plan ahead</p>
        <h2 id="calc-title" data-split class="mt-5 font-serif text-title font-light">What would it <em class="italic">cost a month?</em></h2>
        <p data-reveal class="mt-8 max-w-md leading-relaxed text-stone-light">
          A quick estimate of principal and interest. Use it to frame a budget, then let a lender give you the real number.
        </p>
        <div data-reveal class="mt-10">
          <Button href="/v2/contact" variant="line-light">Talk it through</Button>
        </div>
      </div>

      <form data-calc data-reveal class="rounded-md border border-cream/12 bg-forest-2/60 p-6 md:p-10 lg:col-span-6 lg:col-start-7" onsubmit="return false">
        <p class="label text-sage">Estimated monthly payment</p>
        <p class="mt-3 font-serif text-stat font-light" aria-live="polite" data-calc-out>$0</p>
        <p class="mt-2 text-xs text-stone-light">Principal &amp; interest only. Excludes property tax, insurance and HOA.</p>

        <div class="mt-10 space-y-8">
          <label class="block">
            <span class="flex justify-between text-sm"><span>Home price</span><output data-calc-label="price"></output></span>
            <input class="range mt-3 w-full" type="range" name="price" min="500000" max="3000000" step="10000" value="1250000" />
          </label>
          <label class="block">
            <span class="flex justify-between text-sm"><span>Down payment</span><output data-calc-label="down"></output></span>
            <input class="range mt-3 w-full" type="range" name="down" min="5" max="50" step="1" value="20" />
          </label>
          <label class="block">
            <span class="flex justify-between text-sm"><span>Interest rate <span class="text-stone-light">(example)</span></span><output data-calc-label="rate"></output></span>
            <input class="range mt-3 w-full" type="range" name="rate" min="3" max="9" step="0.125" value="6.5" />
          </label>
          <fieldset class="flex items-center justify-between text-sm">
            <legend class="float-left">Loan term</legend>
            <div class="flex gap-1 rounded-full border border-cream/20 p-1">
              <label class="term"><input type="radio" name="term" value="30" checked class="sr-only" /><span>30 yrs</span></label>
              <label class="term"><input type="radio" name="term" value="15" class="sr-only" /><span>15 yrs</span></label>
            </div>
          </fieldset>
        </div>
        <dl class="mt-10 grid grid-cols-2 gap-6 border-t border-cream/12 pt-6 text-sm">
          <div><dt class="text-stone-light">Loan amount</dt><dd class="mt-1 font-serif text-2xl" data-calc-loan>—</dd></div>
          <div><dt class="text-stone-light">Down payment</dt><dd class="mt-1 font-serif text-2xl" data-calc-downamt>—</dd></div>
        </dl>
      </form>
    </div>
  </section>

  <!-- ============================================================ VIDEOS -->
  <section class="py-28 md:py-40" aria-labelledby="films-title">
    <div class="mx-auto flex max-w-[1680px] flex-col gap-8 px-5 md:flex-row md:items-end md:justify-between md:px-10">
      <div>
        <p class="label flex items-center gap-3 text-stone">( 07 ) On YouTube <Sample /></p>
        <h2 id="films-title" data-split class="mt-5 font-serif text-title font-light">Short films, <em class="italic">straight answers.</em></h2>
      </div>
      <Button href={site.youtube.value} variant="line" external>Visit the channel</Button>
    </div>
    <div data-drag data-cursor-text="Drag" class="mt-14 flex cursor-grab snap-x gap-4 overflow-x-auto px-5 pb-2 [scrollbar-width:none] md:gap-6 md:px-10">
      {
        videoList.map((v) => (
          <a href={site.youtube.value} target="_blank" rel="noopener" draggable="false" class="group relative block w-[64vw] shrink-0 snap-start sm:w-[36vw] lg:w-[21vw]">
            <div class="relative aspect-[9/16] overflow-hidden rounded-sm bg-forest">
              <img src={unsplash(v.thumb, 640, 16 / 9)} alt="" loading="lazy" draggable="false" class="size-full object-cover transition-transform duration-1000 ease-out-expo group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-forest/85 via-transparent to-transparent" />
              <span class="label absolute top-4 left-4 text-cream">{v.minutes}</span>
              <span class="absolute top-4 right-4 grid size-11 place-items-center rounded-full border border-cream/40 text-cream backdrop-blur-sm">
                <svg class="ml-0.5 size-3" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M3 1.5v9l7.5-4.5z" /></svg>
              </span>
              <p class="absolute inset-x-4 bottom-4 font-serif text-2xl leading-tight text-cream">{v.title}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ============================================================ RECOGNITION -->
  <section class="mx-auto max-w-[1680px] px-5 pb-28 md:px-10 md:pb-40" aria-labelledby="awards-title">
    <div data-awards class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-28">
          <p class="label flex items-center gap-3 text-stone">( 08 ) Recognition <Sample /></p>
          <div class="mt-5 flex items-end justify-between gap-6">
            <h2 id="awards-title" data-split class="font-serif text-title font-light">Awards.</h2>
            <p class="pb-2 text-right">
              <span class="block font-serif text-stat leading-none font-light">{String(awards.length).padStart(2, '0')}</span>
              <span class="label text-stone">{awards.at(-1)!.year} — {awards[0].year}</span>
            </p>
          </div>
          <div class="relative mt-10 aspect-[4/3] overflow-hidden rounded-sm bg-forest lg:aspect-auto lg:h-[54vh]" data-cursor-text="Award">
            {
              awards.map((a, i) => (
                <img
                  data-award-img={i}
                  src={unsplash(a.photo!, 900, 1.25)}
                  srcset={srcset(a.photo!, 1.25, [480, 768, 1100])}
                  sizes="(min-width: 1024px) 36vw, 92vw"
                  alt=""
                  loading="lazy"
                  class:list={['award-img absolute inset-0 size-full object-cover', i === 0 && 'is-on']}
                />
              ))
            }
            <div class="absolute inset-0 bg-gradient-to-t from-forest/85 via-transparent to-transparent"></div>
            <div class="absolute inset-x-6 bottom-6 flex items-end justify-between gap-4 text-cream">
              <p class="font-serif text-3xl font-light" data-award-caption>{awards[0].title}</p>
              <p class="font-serif text-5xl leading-none font-light" data-award-year>{awards[0].year}</p>
            </div>
          </div>
          <p class="mt-4 text-xs text-stone">Sample photos. Thang’s own photos of each award replace these.</p>
        </div>
      </div>

      <ol class="lg:col-span-7 lg:pt-24">
        {
          awards.map((a, i) => (
            <li>
              <button
                type="button"
                data-award-row={i}
                aria-pressed={i === 0 ? 'true' : 'false'}
                class="award-row group relative grid w-full grid-cols-12 items-baseline gap-4 overflow-hidden border-b border-ink/15 py-7 text-left"
              >
                <span class="award-fill absolute inset-0 bg-forest" aria-hidden="true" />
                <span class="award-txt relative col-span-3 font-serif text-3xl font-light md:col-span-2 md:text-4xl">{a.year}</span>
                <span class="award-txt relative col-span-9 text-lg md:col-span-5">{a.title}</span>
                <span class="award-txt relative col-span-9 col-start-4 text-sm opacity-70 md:col-span-4 md:col-start-auto md:text-right">{a.issuer}</span>
                <span class="award-txt relative hidden text-right md:col-span-1 md:block" aria-hidden="true">↗</span>
              </button>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============================================================ JOURNAL -->
  <section class="border-t border-ink/10" aria-labelledby="journal-title">
    <div class="mx-auto max-w-[1680px] px-5 py-28 md:px-10 md:py-40">
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="label flex items-center gap-3 text-stone">( 09 ) Journal <Sample /></p>
          <h2 id="journal-title" data-split class="mt-5 font-serif text-title font-light">Notes from <em class="italic">the market.</em></h2>
        </div>
        <Button href="/v2/journal" variant="line">All articles</Button>
      </div>
      <div class="mt-14 grid gap-10 lg:grid-cols-12">
        <a href={`/v2/journal/${posts[0].slug}`} data-cursor-text="Read" class="group lg:col-span-7">
          <div data-img-reveal class="aspect-[16/11] overflow-hidden rounded-sm">
            <img src={unsplash(posts[0].cover, 1400, 0.6875)} srcset={srcset(posts[0].cover, 0.6875)} sizes="(min-width: 1024px) 55vw, 92vw" alt="" loading="lazy" class="size-full object-cover transition-transform duration-1000 ease-out-expo group-hover:scale-[1.03]" />
          </div>
          <p class="label mt-6 text-stone">{posts[0].tag} · {longDate(posts[0].date)}</p>
          <h3 class="mt-3 font-serif text-5xl font-light">{posts[0].title}</h3>
        </a>
        <ul class="lg:col-span-5">
          {
            posts.slice(1, 4).map((p) => (
              <li class="border-b border-ink/15 first:border-t">
                <a href={`/v2/journal/${p.slug}`} class="group flex gap-5 py-6">
                  <img src={unsplash(p.cover, 300, 1)} alt="" loading="lazy" class="size-24 shrink-0 rounded-sm object-cover" />
                  <div>
                    <p class="label text-stone">{p.tag} · {p.minutes} min</p>
                    <h3 class="mt-2 font-serif text-2xl leading-snug font-light transition-colors group-hover:text-brass">{p.title}</h3>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .city-btn {
    display: flex;
    width: 100%;
    justify-content: space-between;
    gap: 0.75rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-ink) 12%, transparent);
    padding: 0.7rem 0;
    text-align: left;
    font-size: 0.9375rem;
    color: var(--color-stone);
    transition: color 0.3s, padding 0.5s var(--ease-out-expo);
  }
  .city-btn span {
    font-family: var(--font-serif);
    font-size: 1.15rem;
  }
  .city-btn:hover,
  .city-btn[aria-pressed='true'] {
    color: var(--color-ink);
    padding-left: 0.5rem;
  }
  .tab {
    border-radius: 9999px;
    padding: 0.6rem 1.3rem;
    font-size: 0.8125rem;
    font-weight: 600;
    transition: background 0.4s, color 0.4s;
  }
  .tab[aria-selected='true'] {
    background: var(--color-forest);
    color: var(--color-cream);
  }
  .process-img {
    opacity: 0;
    transform: scale(1.06);
    transition: opacity 0.9s var(--ease-out-expo), transform 1.4s var(--ease-out-expo);
  }
  .process-img:global(.is-on) {
    opacity: 1;
    transform: none;
  }
  @media (min-width: 1024px) {
    .step {
      opacity: 0.3;
      transition: opacity 0.6s var(--ease-out-expo);
    }
    .step:global(.is-active) {
      opacity: 1;
    }
  }
  .term span {
    display: inline-block;
    border-radius: 9999px;
    padding: 0.45rem 0.9rem;
    cursor: pointer;
    transition: background 0.3s, color 0.3s;
  }
  .term input:checked + span {
    background: var(--color-cream);
    color: var(--color-ink);
  }
  .term input:focus-visible + span {
    outline: 1.5px solid var(--color-sage);
  }
  .award-img {
    opacity: 0;
    transform: scale(1.08);
    filter: saturate(0.85) contrast(1.04);
    transition: opacity 0.8s var(--ease-out-expo), transform 1.4s var(--ease-out-expo);
  }
  .award-img:global(.is-on) {
    opacity: 1;
    transform: none;
  }
  .award-row:first-child {
    border-top: 1px solid color-mix(in oklab, var(--color-ink) 15%, transparent);
  }
  li:first-child > .award-row {
    border-top: 1px solid color-mix(in oklab, var(--color-ink) 15%, transparent);
  }
  .award-fill {
    transform: translateY(101%);
    transition: transform 0.7s var(--ease-out-expo);
  }
  .award-txt {
    transition: transform 0.7s var(--ease-out-expo), color 0.4s;
  }
  .award-row:hover .award-fill,
  .award-row[aria-pressed='true'] .award-fill {
    transform: none;
  }
  .award-row:hover .award-txt,
  .award-row[aria-pressed='true'] .award-txt {
    color: var(--color-cream);
    transform: translateX(1.25rem);
  }
  .award-row:hover .award-txt:last-child,
  .award-row[aria-pressed='true'] .award-txt:last-child {
    transform: translateX(-1.25rem);
  }
  [data-drag]:global(.is-dragging) {
    cursor: grabbing;
    scroll-snap-type: none;
  }
</style>

<script>
  // Awards: hovering (or tapping) a row swaps the photo on the left.
  const awardRows = [...document.querySelectorAll<HTMLButtonElement>('[data-award-row]')];
  const awardImgs = [...document.querySelectorAll<HTMLElement>('[data-award-img]')];
  const caption = document.querySelector<HTMLElement>('[data-award-caption]');
  const yearEl = document.querySelector<HTMLElement>('[data-award-year]');
  const pick = (btn: HTMLButtonElement) => {
    const i = btn.dataset.awardRow!;
    awardRows.forEach((r) => r.setAttribute('aria-pressed', String(r === btn)));
    awardImgs.forEach((im) => im.classList.toggle('is-on', im.dataset.awardImg === i));
    const cells = btn.querySelectorAll('.award-txt');
    if (yearEl) yearEl.textContent = cells[0]?.textContent ?? '';
    if (caption) caption.textContent = cells[1]?.textContent ?? '';
  };
  awardRows.forEach((r) => ['pointerenter', 'focus', 'click'].forEach((ev) => r.addEventListener(ev, () => pick(r))));

  const form = document.querySelector<HTMLFormElement>('[data-calc]');
  if (form) {
    const usd = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
    const out = form.querySelector<HTMLElement>('[data-calc-out]')!;
    const loanEl = form.querySelector<HTMLElement>('[data-calc-loan]')!;
    const downEl = form.querySelector<HTMLElement>('[data-calc-downamt]')!;
    const label = (k: string) => form.querySelector<HTMLElement>(`[data-calc-label="${k}"]`)!;
    const update = () => {
      const f = new FormData(form);
      const price = Number(f.get('price'));
      const downPct = Number(f.get('down'));
      const rate = Number(f.get('rate'));
      const years = Number(f.get('term'));
      const down = (price * downPct) / 100;
      const loan = price - down;
      const r = rate / 100 / 12;
      const n = years * 12;
      const monthly = r === 0 ? loan / n : (loan * r) / (1 - Math.pow(1 + r, -n));
      out.textContent = usd(Math.round(monthly));
      loanEl.textContent = usd(loan);
      downEl.textContent = usd(down);
      label('price').textContent = usd(price);
      label('down').textContent = `${downPct}%`;
      label('rate').textContent = `${rate.toFixed(3).replace(/0+$/, '').replace(/\.$/, '')}%`;
      form.querySelectorAll<HTMLInputElement>('input[type=range]').forEach((el) => {
        const p = ((Number(el.value) - Number(el.min)) / (Number(el.max) - Number(el.min))) * 100;
        el.style.setProperty('--p', `${p}%`);
      });
    };
    form.addEventListener('input', update);
    update();
  }
</script>
