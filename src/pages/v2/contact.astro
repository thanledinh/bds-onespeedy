---
import Layout from '../../v2/Layout.astro';
import { site } from '../../config/site';
import { photos } from '../../data/media';
import { unsplash, srcset } from '../../lib/img';
const tel = site.phone.value.replace(/[^\d+]/g, '');
const intents = ['Selling', 'Buying', 'Both', 'Just curious'];
const timings = ['Right away', 'Within 3 months', 'This year', 'Not sure yet'];
---

<Layout title="Contact" page="contact" navSolid description="Book a consultation with Thang Truong about buying or selling in San Jose and the Bay Area.">
  <section class="grid min-h-svh lg:grid-cols-2">
    <div class="relative hidden overflow-hidden bg-forest lg:block">
      <img data-parallax="5" src={unsplash(photos.duskModern, 1600, 1.2)} srcset={srcset(photos.duskModern, 1.2, [800, 1200, 1600, 2000])} sizes="50vw" alt="" class="absolute inset-0 size-full scale-[1.12] object-cover opacity-85" />
      <div class="absolute inset-0 bg-gradient-to-t from-forest/90 via-forest/20 to-forest/30"></div>
      <div class="absolute inset-x-10 bottom-12 text-cream">
        <p class="label text-sage">Direct</p>
        <p class="mt-4 font-serif text-5xl font-light"><a href={`tel:${tel}`} class="hover:italic">{site.phone.value}</a></p>
        <p class="mt-2 font-serif text-3xl font-light"><a href={`mailto:${site.email.value}`} class="hover:italic">{site.email.value}</a></p>
        <p class="label mt-8 text-stone-light">{site.area} · {site.dre.value}</p>
      </div>
    </div>

    <div class="px-5 pt-36 pb-28 md:px-10 md:pt-44 lg:px-16">
      <p class="label text-stone">Contact</p>
      <h1 data-split class="mt-6 font-serif text-title font-light">Let’s talk about <em class="italic">your move.</em></h1>
      <p data-reveal class="mt-8 max-w-md leading-relaxed text-stone">A few details help Thang prepare before you speak. Thang will get back to you personally.</p>

      <form data-contact data-reveal class="mt-14 max-w-xl space-y-10" novalidate>
        <fieldset>
          <legend class="label text-stone">I’m interested in</legend>
          <div class="mt-4 flex flex-wrap gap-2">
            {intents.map((v, i) => <label class="chip"><input type="radio" name="intent" value={v} class="sr-only" checked={i === 0} /><span>{v}</span></label>)}
          </div>
        </fieldset>
        <fieldset>
          <legend class="label text-stone">Timing</legend>
          <div class="mt-4 flex flex-wrap gap-2">
            {timings.map((v, i) => <label class="chip"><input type="radio" name="timing" value={v} class="sr-only" checked={i === 0} /><span>{v}</span></label>)}
          </div>
        </fieldset>
        <div class="grid gap-8 sm:grid-cols-2">
          <label class="field"><input name="name" placeholder=" " autocomplete="name" required /><span>Full name</span></label>
          <label class="field"><input name="phone" type="tel" placeholder=" " autocomplete="tel" /><span>Phone</span></label>
          <label class="field sm:col-span-2"><input name="email" type="email" placeholder=" " autocomplete="email" required /><span>Email</span></label>
          <label class="field sm:col-span-2"><textarea name="message" rows="3" placeholder=" "></textarea><span>Neighborhood, budget, anything else</span></label>
        </div>
        <div class="flex flex-wrap items-center gap-6">
          <button type="submit" data-magnetic class="group relative inline-flex items-center gap-3 overflow-hidden rounded-full bg-forest px-9 py-4 text-[0.8125rem] font-semibold tracking-wide text-cream">
            <span class="absolute inset-0 translate-y-full rounded-full bg-ink transition-transform duration-700 ease-out-expo group-hover:translate-y-0" aria-hidden="true"></span>
            <span class="relative">Send request</span>
          </button>
          <p class="text-xs text-stone">Your details go only to Thang.</p>
        </div>
        <p data-contact-status class="hidden border-l-2 border-brass pl-4 text-sm" role="status"></p>
      </form>

      <div class="mt-16 border-t border-ink/15 pt-8 lg:hidden">
        <p class="font-serif text-4xl font-light"><a href={`tel:${tel}`}>{site.phone.value}</a></p>
        <p class="mt-1 text-stone"><a href={`mailto:${site.email.value}`}>{site.email.value}</a></p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .chip span {
    display: inline-block;
    border: 1px solid color-mix(in oklab, var(--color-ink) 20%, transparent);
    border-radius: 9999px;
    padding: 0.6rem 1.15rem;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background 0.35s, color 0.35s, border-color 0.35s;
  }
  .chip input:checked + span {
    background: var(--color-forest);
    border-color: var(--color-forest);
    color: var(--color-cream);
  }
  .chip input:focus-visible + span {
    outline: 1.5px solid var(--color-brass);
    outline-offset: 2px;
  }
  .field {
    position: relative;
    display: block;
    padding-top: 1.1rem;
  }
  .field input,
  .field textarea {
    width: 100%;
    border: 0;
    border-bottom: 1px solid color-mix(in oklab, var(--color-ink) 25%, transparent);
    background: transparent;
    padding: 0.5rem 0;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    outline: none;
    resize: vertical;
    transition: border-color 0.3s;
  }
  .field span {
    position: absolute;
    left: 0;
    top: 1.55rem;
    color: var(--color-stone);
    pointer-events: none;
    transform-origin: left;
    transition: transform 0.5s var(--ease-out-expo), color 0.3s;
  }
  .field input:focus,
  .field textarea:focus {
    border-color: var(--color-forest);
  }
  .field input:focus + span,
  .field input:not(:placeholder-shown) + span,
  .field textarea:focus + span,
  .field textarea:not(:placeholder-shown) + span {
    transform: translateY(-1.45rem) scale(0.78);
    color: var(--color-ink);
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]')!;
  const status = form.querySelector<HTMLElement>('[data-contact-status]')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    status.classList.remove('hidden');
    if (!form.checkValidity()) {
      status.textContent = 'Please add your name and a valid email.';
      return;
    }
    status.textContent = 'Demo only: on the live site this request goes straight to Thang’s inbox.';
    form.reset();
  });
</script>
