---
import Layout from '../../v2/Layout.astro';
import Button from '../../v2/Button.astro';
import Sample from '../../v2/Sample.astro';
import { site } from '../../config/site';
import { soldStats } from '../../data/sold';
import { career, awards } from '../../data/content';
import { unsplash, srcset, compactMoney } from '../../lib/img';
---

<Layout title="About" page="about" description="Meet Thang Truong, real estate agent in San Jose and the Bay Area.">
  <!-- ============================================================ INTRO -->
  <section class="mx-auto max-w-[1680px] px-5 pt-36 pb-24 md:px-10 md:pt-48 md:pb-36">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="label flex items-center gap-3 text-stone">About <Sample /></p>
        <h1 data-split class="mt-6 font-serif text-hero font-light">{site.firstName} <em class="italic">{site.lastName}</em></h1>
        <p data-reveal class="mt-8 font-serif text-3xl font-light text-stone md:text-4xl">{site.role}, {site.area}</p>
        <div data-reveal class="mt-12 max-w-xl space-y-5 text-lg leading-relaxed text-stone">
          <p>
            Thang’s story goes here: where it started, what led to real estate, and the neighborhoods Thang knows street by
            street.
          </p>
          <p>
            A second paragraph on how Thang works with buyers and sellers, the languages spoken, and what clients can expect
            from the first call to closing day.
          </p>
        </div>
        <div data-reveal class="mt-12 flex flex-wrap gap-3">
          <Button href="/v2/contact">Book a consultation</Button>
          <Button href="/v2/sold" variant="line">See sold homes</Button>
        </div>
      </div>
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-28">
          <div data-img-reveal class="hatch relative grid aspect-[4/5] place-items-center overflow-hidden rounded-sm bg-bone-2 text-stone">
            <div class="text-center">
              <svg class="mx-auto size-12" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1"><circle cx="20" cy="15" r="6.5"></circle><path d="M7.5 34c1.8-6.4 6.6-9.5 12.5-9.5S30.7 27.6 32.5 34"></path></svg>
              <p class="label mt-4">Portrait of Thang</p>
              <p class="mt-1 text-xs">Professional photo to be taken</p>
            </div>
          </div>
          <p class="mt-6 font-serif text-3xl font-light italic">“Quote from Thang about why this work matters.”</p>
          <p class="label mt-3 text-stone">— {site.name.value}</p>
        </div>
      </div>
    </div>

    <dl class="mt-24 grid grid-cols-2 gap-x-6 gap-y-10 border-t border-ink/15 pt-8 md:grid-cols-4">
      <div><dd class="font-serif text-stat font-light whitespace-nowrap" data-count-up={String(soldStats.count)}>{soldStats.count}</dd><dt class="label mt-3 text-stone">Homes sold</dt></div>
      <div><dd class="font-serif text-stat font-light whitespace-nowrap" data-count-up={compactMoney(soldStats.volume)}>{compactMoney(soldStats.volume)}</dd><dt class="label mt-3 text-stone">Sales volume</dt></div>
      <div><dd class="font-serif text-stat font-light whitespace-nowrap" data-count-up={String(soldStats.cities)}>{soldStats.cities}</dd><dt class="label mt-3 text-stone">Cities served</dt></div>
      <div><dd class="font-serif text-stat font-light whitespace-nowrap" data-count-up={String(awards.length)}>{awards.length}</dd><dt class="label mt-3 text-stone">Awards</dt></div>
    </dl>
  </section>

  <!-- ============================================================ CAREER (horizontal on desktop) -->
  <section data-hrail data-dark class="relative bg-forest text-cream lg:flex lg:h-svh lg:flex-col lg:justify-center" aria-labelledby="career-title">
    <div class="mx-auto w-full max-w-[1680px] px-5 pt-28 md:px-10 lg:pt-24">
      <p class="label flex items-center gap-3 text-sage">( 01 ) Career <Sample /></p>
      <h2 id="career-title" data-split class="mt-5 font-serif text-title font-light">The road <em class="italic">so far.</em></h2>
    </div>
    <div class="relative mt-14 pb-28 lg:pb-0">
      <ol data-hrail-track class="flex flex-col gap-14 px-5 md:px-10 lg:w-max lg:flex-row lg:gap-0">
        {
          career.map((m, i) => (
            <li class="relative lg:w-[34vw] lg:pr-16 xl:w-[28vw]">
              <span class="hidden h-px w-full bg-cream/15 lg:block" aria-hidden="true" />
              <span class="absolute top-0 left-0 hidden size-2 -translate-y-1/2 rounded-full bg-sage lg:block" aria-hidden="true" />
              <p class="font-serif text-7xl leading-none font-light lg:mt-10 lg:text-8xl">{m.year}</p>
              <p class="label mt-6 text-sage">{m.org}</p>
              <h3 class="mt-3 font-serif text-4xl font-light">{m.title}</h3>
              <p class="mt-4 max-w-sm leading-relaxed text-stone-light">{m.text}</p>
              {m.photo && <img src={unsplash(m.photo, 800, 0.66)} alt="" loading="lazy" class="mt-8 aspect-[3/2] w-full max-w-md rounded-sm object-cover opacity-90" />}
              <span class="label mt-6 block text-stone-light">{String(i + 1).padStart(2, '0')} / {String(career.length).padStart(2, '0')}</span>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="mx-auto mt-10 hidden w-full max-w-[1680px] px-10 lg:block">
      <div class="h-px w-full bg-cream/15"><div data-hrail-bar class="h-px origin-left bg-sage"></div></div>
    </div>
  </section>

  <!-- ============================================================ AWARDS GRID -->
  <section id="awards" class="mx-auto max-w-[1680px] scroll-mt-24 px-5 py-28 md:px-10 md:py-40" aria-labelledby="awards-title">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="label flex items-center gap-3 text-stone">( 02 ) Recognition <Sample /></p>
        <h2 id="awards-title" data-split class="mt-5 font-serif text-title font-light">Awards.</h2>
      </div>
      <p data-reveal class="max-w-sm text-sm leading-relaxed text-stone">Each award with Thang’s own photo. Demo images are samples.</p>
    </div>
    <ul data-reveal-group class="mt-14 grid grid-cols-2 gap-x-4 gap-y-12 md:grid-cols-3 md:gap-x-6">
      {
        awards.map((a) => (
          <li>
            <div class="aspect-[4/5] overflow-hidden rounded-sm bg-forest" data-cursor-text="Award">
              <img src={unsplash(a.photo!, 700, 1.25)} srcset={srcset(a.photo!, 1.25, [400, 700, 1000])} sizes="(min-width: 768px) 30vw, 46vw" alt="" loading="lazy" class="size-full object-cover saturate-[0.85] transition-transform duration-1000 ease-out-expo hover:scale-[1.04]" />
            </div>
            <div class="mt-4 flex items-baseline justify-between gap-3 border-t border-ink/15 pt-3">
              <p class="text-sm md:text-base">{a.title}</p>
              <p class="font-serif text-3xl leading-none font-light">{a.year}</p>
            </div>
            <p class="mt-1 text-sm text-stone">{a.issuer}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============================================================ LICENSE -->
  <section class="mx-auto max-w-[1680px] px-5 pb-32 md:px-10 md:pb-44">
    <div data-reveal class="grid gap-8 border-y border-ink/15 py-12 md:grid-cols-12 md:items-center">
      <p class="label text-stone md:col-span-3">License</p>
      <div class="md:col-span-6">
        <p class="font-serif text-5xl font-light">{site.dre.value}</p>
        <p class="mt-2 text-stone">California Department of Real Estate · {site.brokerage.value}</p>
      </div>
      <div class="md:col-span-3 md:text-right">
        <Button href="https://www2.dre.ca.gov/publicasp/pplinfo.asp" variant="line" external>Verify license</Button>
      </div>
    </div>
  </section>
</Layout>
