---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import SampleTag from '../components/SampleTag.astro';
import { site } from '../config/site';
import { videoList } from '../data/content';
import { unsplash } from '../lib/img';
---

<Base title="Videos" description="Short videos from Thang Truong on buying and selling homes in San Jose and the Bay Area.">
  <section class="mx-auto max-w-[1600px] px-6 pt-36 pb-16 md:px-12 md:pt-48 md:pb-24">
    <p class="flex items-center gap-3 text-micro font-medium uppercase text-muted">
      <span class="text-accent">On YouTube</span>
      <SampleTag />
    </p>
    <h1 data-split class="mt-6 text-mega font-medium">Videos</h1>
    <div class="mt-12 flex flex-col gap-8 border-t border-ink/10 pt-8 md:flex-row md:items-end md:justify-between">
      <p data-reveal class="max-w-xl text-lg leading-relaxed text-muted">
        Short tours, market updates and straight answers. New videos appear here automatically from Thang’s YouTube channel.
      </p>
      <div data-reveal>
        <Button href={site.youtube.value} external>Subscribe on YouTube</Button>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1600px] px-6 pb-32 md:px-12 md:pb-44" aria-label="Video list">
    <ul data-reveal-group class="grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 md:gap-x-6 lg:grid-cols-4">
      {
        videoList.map((v) => (
          <li>
            <button
              type="button"
              class="group block w-full text-left"
              data-yt={v.youtubeId ?? ''}
              data-href={site.youtube.value}
              aria-label={`Play: ${v.title}`}
            >
              <span class="relative block aspect-[9/16] overflow-hidden rounded-md bg-ink" data-yt-frame>
                <img
                  src={v.youtubeId ? `https://i.ytimg.com/vi/${v.youtubeId}/hqdefault.jpg` : unsplash(v.thumb, 640, 16 / 9)}
                  alt=""
                  loading="lazy"
                  class="size-full object-cover opacity-90 transition duration-1000 ease-out-expo group-hover:scale-105 group-hover:opacity-100"
                />
                <span class="absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-ink/10" />
                <span class="absolute top-3 left-3 rounded-full bg-ink/50 px-2.5 py-1 text-micro font-medium text-paper backdrop-blur">
                  {v.minutes}
                </span>
                {v.sample && <SampleTag tone="glass" class="absolute top-3 right-3" />}
                <span class="absolute top-1/2 left-1/2 grid size-14 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-paper/90 text-ink transition-transform duration-500 ease-out-expo group-hover:scale-110">
                  <svg class="ml-0.5 size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d="M4 2.5v11l9-5.5z" />
                  </svg>
                </span>
                <span class="absolute inset-x-4 bottom-4 text-base leading-snug font-medium text-paper">{v.title}</span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  // Lightweight YouTube facade: the player loads only after a click.
  document.querySelectorAll<HTMLButtonElement>('[data-yt]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.yt;
      if (!id) {
        window.open(btn.dataset.href, '_blank', 'noopener');
        return;
      }
      const frame = btn.querySelector<HTMLElement>('[data-yt-frame]')!;
      frame.innerHTML = `<iframe class="absolute inset-0 size-full" src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&playsinline=1" title="YouTube video" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
    });
  });
</script>
