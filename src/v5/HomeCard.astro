---
/** One sold home: photo on top, facts underneath (never text over the photo). Opens the details drawer. */
import type { SoldHome } from '../data/sold';
import { unsplash, srcset, money, monthYear } from '../lib/img';

interface Props {
  home: SoldHome;
  sizes?: string;
  /** Part of a paged grid (src/v5/extras.ts). */
  gridItem?: boolean;
  hidden?: boolean;
  class?: string;
}
const { home: h, sizes = '(min-width: 1024px) 26vw, (min-width: 640px) 45vw, 46vw', gridItem = false, hidden = false, class: cls = '' } = Astro.props;
---

<button
  type="button"
  data-home-tile={h.id}
  data-grid-item={gridItem ? '' : undefined}
  data-city={h.city}
  hidden={hidden}
  class:list={['group block w-full text-left', cls]}
>
  <span class="block aspect-[4/3] overflow-hidden rounded-md bg-mist">
    <img
      src={unsplash(h.photo, 600, 0.75)}
      srcset={srcset(h.photo, 0.75, [400, 600, 900])}
      sizes={sizes}
      alt={`${h.type} in ${h.neighborhood}, ${h.city}`}
      loading="lazy"
      class="size-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-[1.03]"
    />
  </span>
  <span class="mt-3 flex items-baseline justify-between gap-3">
    <span class="font-display text-xl leading-none">{money(h.soldPrice)}</span>
    <span class="shrink-0 text-xs text-slate">{monthYear(h.closeDate)}</span>
  </span>
  <span class="mt-1.5 block truncate text-sm text-slate">{h.neighborhood}, {h.city} · {h.beds} bd · {h.baths} ba</span>
</button>
