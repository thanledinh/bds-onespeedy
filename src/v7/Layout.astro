---
/**
 * Signature (/v7). Own palette and type, but the same behaviour as Option C
 * (chat, details drawer, contact card, QR) through the shared script.
 */
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/300-italic.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource-variable/manrope';
import './styles.css';
import VersionSwitch from '../components/VersionSwitch.astro';
import { site, assertNoPlaceholders } from '../config/site';

assertNoPlaceholders();

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.seo.description } = Astro.props;
const fullTitle = title ? `${title} — ${site.name.value}` : site.seo.title;
const tel = site.phone.value.replace(/[^\d+]/g, '');
const links = [
  { label: 'Sales', href: '#sales' },
  { label: '360° tour', href: '#tour' },
  { label: 'About', href: '#about' },
  { label: 'Journal', href: '#journal' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {site.mode === 'demo' && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#10110f" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <script is:inline>
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (!window.__motion) document.documentElement.classList.remove('js');
      }, 2500);
    </script>
    <style is:global>
      .js [data-split],
      .js [data-pre-hide] {
        visibility: hidden;
      }
    </style>
  </head>
  <body class="bg-porcelain text-ink">
    <header data-topbar class="sig-nav fixed inset-x-0 top-0 z-50 text-porcelain">
      <div class="mx-auto flex h-16 max-w-[1400px] items-center justify-between gap-6 px-5 md:h-[72px] md:px-10">
        <a href="/v7" class="font-display text-[1.65rem] leading-none font-medium tracking-tight">{site.name.value}</a>
        <nav aria-label="Sections" class="hidden md:block">
          <ul class="flex items-center gap-9">
            {links.map((l) => <li><a href={l.href} class="label opacity-75 transition-opacity hover:opacity-100">{l.label}</a></li>)}
          </ul>
        </nav>
        <button type="button" data-chat-open class="btn btn-light hidden py-2.5! sm:inline-flex">Message Thang</button>
      </div>
    </header>

    <main id="main" class="relative">
      <slot />
    </main>

    <footer class="bg-night text-porcelain">
      <div class="mx-auto max-w-[1400px] px-5 pt-24 pb-28 md:px-10 md:pt-32 md:pb-14">
        <p class="label text-gold">Begin a conversation</p>
        <p class="mt-6 max-w-4xl font-display text-title font-light">Let’s talk about <em class="italic">home.</em></p>
        <div class="mt-10 flex flex-wrap gap-3">
          <button type="button" data-chat-open class="btn btn-light">Message Thang</button>
          <a href={`tel:${tel}`} class="btn btn-line">{site.phone.value}</a>
          <a href={`mailto:${site.email.value}`} class="btn btn-line">{site.email.value}</a>
        </div>
        <div class="mt-20 grid gap-3 border-t border-porcelain/10 pt-6 text-sm text-slate-light md:grid-cols-4">
          <p>{site.name.value} · {site.dre.value}</p>
          <p>{site.brokerage.value}</p>
          <p>Equal Housing Opportunity</p>
          <p class="md:text-right">© {new Date().getFullYear()} {site.name.value}</p>
        </div>
        {site.mode === 'demo' && <p class="mt-4 text-sm text-slate-light/80">Demo: photos, numbers, articles and the 360° tour are sample content.</p>}
      </div>
    </footer>

    <!-- Phones: two actions only -->
    <nav class="dock fixed inset-x-3 bottom-3 z-40 grid grid-cols-2 gap-1.5 rounded-xl bg-night p-1.5 text-porcelain shadow-lift sm:hidden" aria-label="Quick contact" style="padding-bottom: max(0.375rem, env(safe-area-inset-bottom))">
      <a href={`tel:${tel}`} class="dock-btn">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 3h3l1.5 4-2 1.2a9 9 0 0 0 5.3 5.3l1.2-2 4 1.5v3a1.5 1.5 0 0 1-1.6 1.5A14 14 0 0 1 2.5 4.6 1.5 1.5 0 0 1 4 3z"></path></svg>
        Call
      </a>
      <button type="button" data-chat-open class="dock-btn bg-porcelain text-night">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3.5 15.5 4.6 12A6.5 6.5 0 1 1 8 15.4z"></path></svg>
        Message
      </button>
    </nav>

    <!-- Chat panel -->
    <section data-chat class="chat fixed z-[60] flex flex-col overflow-hidden bg-card shadow-lift" role="dialog" aria-modal="false" aria-label="Message Thang" hidden>
      <header class="flex items-center gap-3 bg-night px-4 py-3.5 text-porcelain">
        <span class="grid size-10 place-items-center rounded-full bg-night-3 text-sm font-bold">{site.initials}</span>
        <div class="min-w-0 flex-1 leading-tight">
          <p class="text-sm font-bold">{site.name.value}</p>
          <p class="text-xs text-slate-light">{site.role} · replies personally</p>
        </div>
        <button type="button" data-chat-close class="grid size-9 place-items-center rounded-full hover:bg-porcelain/10" aria-label="Close chat">
          <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m5 5 10 10M15 5 5 15"></path></svg>
        </button>
      </header>
      <div data-chat-log class="flex-1 space-y-3 overflow-y-auto bg-porcelain px-4 py-5" data-lenis-prevent aria-live="polite"></div>
      <div data-chat-actions class="border-t border-ink/8 bg-card p-3"></div>
    </section>

    <!-- Details drawer (homes, articles) -->
    <div data-drawer class="drawer fixed inset-0 z-[70]" hidden>
      <div data-drawer-scrim class="absolute inset-0 bg-night/50 backdrop-blur-sm"></div>
      <aside class="drawer-panel absolute top-0 right-0 bottom-0 flex w-full max-w-xl flex-col bg-porcelain shadow-lift" role="dialog" aria-modal="true" aria-label="Details">
        <div class="flex items-center justify-between border-b border-ink/8 px-5 py-3.5">
          <p data-drawer-kicker class="label text-slate"></p>
          <button type="button" data-drawer-close class="grid size-9 place-items-center rounded-full hover:bg-mist" aria-label="Close">
            <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m5 5 10 10M15 5 5 15"></path></svg>
          </button>
        </div>
        <div data-drawer-body class="flex-1 overflow-y-auto" data-lenis-prevent></div>
      </aside>
    </div>

    <!-- QR code -->
    <dialog data-qr class="m-auto w-[min(92vw,380px)] rounded-xl bg-card p-0 text-ink shadow-lift">
      <div class="p-7 text-center">
        <p class="label text-slate">Scan to open this page</p>
        <div data-qr-svg class="mx-auto mt-5 aspect-square w-60 rounded-md bg-white p-3"></div>
        <p class="mt-5 font-display text-3xl">{site.name.value}</p>
        <p class="text-sm text-slate">Print it on yard signs, flyers and business cards.</p>
        <div class="mt-6 flex justify-center gap-2">
          <button type="button" data-qr-download class="btn btn-primary">Download PNG</button>
          <button type="button" data-qr-close class="btn btn-ghost">Close</button>
        </div>
      </div>
    </dialog>

    <p data-toast class="toast pointer-events-none fixed top-20 left-1/2 z-[90] -translate-x-1/2 rounded-full bg-night px-5 py-3 text-sm font-semibold text-porcelain shadow-lift" role="status"></p>

    <VersionSwitch current="s" side="left" />

    <script>
      import '../v5/quiet';
      import '../v3/profile';
      import '../v5/extras';
      import './signature';
    </script>
  </body>
</html>

<style>
  .sig-nav {
    transition: background 0.5s, box-shadow 0.5s, backdrop-filter 0.5s;
  }
  .sig-nav:global(.is-scrolled) {
    background: color-mix(in oklab, var(--color-night) 74%, transparent);
    backdrop-filter: blur(18px) saturate(1.2);
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
    box-shadow: 0 1px 0 color-mix(in oklab, var(--color-porcelain) 8%, transparent);
  }
  .dock-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 12px;
    padding: 0.8rem 0;
    font-size: 0.9rem;
    font-weight: 700;
  }
  .dock-btn svg {
    width: 18px;
    height: 18px;
  }
  .chat {
    right: 20px;
    bottom: 20px;
    width: min(400px, calc(100vw - 40px));
    height: min(620px, calc(100svh - 120px));
    border-radius: 22px;
    transform-origin: bottom right;
    animation: chat-in 0.55s var(--ease-out-expo);
  }
  @media (max-width: 639px) {
    .chat {
      inset: 0;
      width: auto;
      height: auto;
      border-radius: 0;
    }
  }
  @keyframes chat-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.96);
    }
  }
  .drawer:not([hidden]) .drawer-panel {
    animation: drawer-in 0.6s var(--ease-out-expo);
  }
  .drawer:not([hidden]) [data-drawer-scrim] {
    animation: fade-in 0.4s;
  }
  @keyframes drawer-in {
    from {
      transform: translateX(100%);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  .toast {
    opacity: 0;
    transform: translate(-50%, -10px);
    transition: opacity 0.35s, transform 0.5s var(--ease-out-expo);
  }
  .toast:global(.is-on) {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>
