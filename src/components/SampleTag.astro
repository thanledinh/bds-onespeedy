---
import { site } from '../config/site';
interface Props {
  tone?: 'light' | 'dark' | 'glass';
  class?: string;
}
const { tone = 'light', class: cls = '' } = Astro.props;
const look = {
  light: 'bg-ink/5 text-muted',
  dark: 'bg-paper/10 text-paper/75',
  glass: 'bg-ink/45 text-paper backdrop-blur-md',
}[tone];
---

{
  site.mode === 'demo' && (
    <span
      class:list={['inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-micro font-medium uppercase', look, cls]}
      title="Sample content for the demo"
    >
      <span class="size-1.5 rounded-full bg-accent-soft" />
      Sample
    </span>
  )
}
