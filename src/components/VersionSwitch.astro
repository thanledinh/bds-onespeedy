---
/** Demo-only switch between the design options. */
import { site } from '../config/site';
interface Props {
  current: 'a' | 'b' | 'c';
  side?: 'right' | 'left';
}
const { current, side = 'right' } = Astro.props;
const options = [
  { id: 'a', label: 'A', href: '/' },
  { id: 'b', label: 'B', href: '/v2' },
  { id: 'c', label: 'C', href: '/v3' },
];
---

{
  site.mode === 'demo' && (
    <nav class:list={['vswitch', side === 'left' && 'is-left']} aria-label="Design options">
      <span class="vswitch-label">Option</span>
      {options.map((o) => (
        <a href={o.href} aria-current={current === o.id ? 'page' : undefined} aria-label={`Design option ${o.label}`}>
          {o.label}
        </a>
      ))}
    </nav>
  )
}

<style>
  /* Neutral colours on purpose: this widget sits on top of every theme. */
  .vswitch {
    position: fixed;
    right: 12px;
    bottom: 12px;
    z-index: 140;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 9999px;
    background: rgb(20 20 18 / 0.8);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    font: 600 11px/1 system-ui, sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f3f0ea;
  }
  .vswitch.is-left {
    right: auto;
    left: 12px;
  }
  .vswitch-label {
    padding: 0 8px 0 10px;
    opacity: 0.55;
  }
  .vswitch a {
    display: grid;
    place-items: center;
    min-width: 30px;
    height: 30px;
    padding: 0 6px;
    border-radius: 9999px;
    color: inherit;
    text-decoration: none;
    opacity: 0.7;
    transition: background 0.3s, color 0.3s, opacity 0.3s;
  }
  .vswitch a:hover {
    opacity: 1;
  }
  .vswitch a[aria-current='page'] {
    background: #f3f0ea;
    color: #141412;
    opacity: 1;
  }
</style>
